{
  "name": "api-microservices",
  "version": "2.0.0",
  "description": "Arquitectura de microservicios con API Gateway, mensajeria asincrona y persistencia poliglota",
  "private": true,
  "workspaces": [
    "gateway",
    "services/*",
    "shared-lib"
  ],
  "scripts": {
    "dev": "concurrently -n gateway,auth,users,products,orders -c blue,green,yellow,magenta,cyan \"npm:dev:*\"",
    "dev:gateway": "npm run dev --workspace=gateway",
    "dev:auth": "npm run dev --workspace=auth-service",
    "dev:users": "npm run dev --workspace=user-service",
    "dev:products": "npm run dev --workspace=product-service",
    "dev:orders": "npm run dev --workspace=order-service",
    "start": "docker compose up -d",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "prepare": "husky"
  },
  "keywords": [
    "microservices",
    "api-gateway",
    "nodejs",
    "express",
    "rabbitmq",
    "docker",
    "kubernetes"
  ],
  "author": "Edgar Alberto Ng Angulo <mr_ng03@hotmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
