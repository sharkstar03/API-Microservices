# Copia este archivo a .env y ajusta los valores.
# Los hosts (mongodb, mysql, redis, rabbitmq) son los nombres de servicio de
# docker-compose. Si corres los servicios fuera de Docker, cámbialos a localhost.

NODE_ENV=development

# Autenticación. Cambia ambos secretos antes de desplegar en cualquier sitio.
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
REFRESH_TOKEN_SECRET=cambia_esto_tambien_y_que_sea_distinta
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Clave para las llamadas internas entre servicios (cabecera x-api-key).
# Si la dejas vacía, ese atajo queda deshabilitado.
INTERNAL_API_KEY=

# Cada servicio recibe su propia MONGODB_URI vía docker-compose.
# Estos son los valores por defecto de cada uno:
#   auth-service   mongodb://mongodb:27017/auth
#   user-service   mongodb://mongodb:27017/users
#   order-service  mongodb://mongodb:27017/orders
MONGODB_URI=mongodb://mongodb:27017/auth

# MySQL (product-service)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root_password
MYSQL_DATABASE=products

REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# URLs internas que usa el gateway para hacer proxy
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
PRODUCT_SERVICE_URL=http://product-service:3003
ORDER_SERVICE_URL=http://order-service:3004

# Rate limiting del gateway
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=info
